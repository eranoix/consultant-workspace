# Copy to .env for `npm run dev`. docker compose sets all of these itself.

# The app connects as a normal role, so row level security applies to it.
# `npm run db:migrate` creates that role from this URL if it does not exist.
DATABASE_URL=postgres://workspace_app:workspace_app@127.0.0.1:5432/workspace
# Migrations and seed run as the database owner.
DATABASE_ADMIN_URL=postgres://workspace_admin:workspace_admin@127.0.0.1:5432/workspace

# Signs the session cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Password for the seeded demo accounts (maya@lumen.example.com, theo@lumen.example.com).
DEMO_PASSWORD=workspace-demo

# AES-256-GCM key for stored OAuth refresh tokens: 32 bytes, base64.
# This one is a public demo key: replace it for anything real. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=bG9jYWwtZGVtby1rZXktb25seS0zMi1ieXRlcyEhISE=
# Optional: the previous key, still able to decrypt while rows are re-encrypted.
ENCRYPTION_KEY_PREVIOUS=

# Public origin, used in links (booking management links, API docs examples).
PUBLIC_URL=http://localhost:3000

# LLM summarizer: "mock" (deterministic, the default) or "openai-compatible".
LLM_PROVIDER=mock
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Calendar: "mock" (default) or "google" (needs the three values below).
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Mail for the email intake and the notes sync: "mock" (default) or "imap".
MAIL_PROVIDER=mock
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Alert delivery. The outbox always works; the others are used when configured
# and fall back to the outbox when they are not.
NOTIFY_EMAIL_WEBHOOK=
NOTIFY_WHATSAPP_WEBHOOK=
NOTIFY_RECIPIENT=maya@lumen.example.com
